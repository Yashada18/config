#include <iostream>
#include <vector>
#include <algorithm>
using namespace std;

int main() {
    int n, capacity;

    cout << "Enter number of items: ";
    cin >> n;

    int profit[100], weight[100];

    cout << "Enter profit and weight of each item:\n";
    for (int i = 0; i < n; i++) {
        cin >> profit[i] >> weight[i];
    }

    cout << "Enter knapsack capacity: ";
    cin >> capacity;

    int dp[101][101] = {0};

    for (int i = 1; i <= n; i++) {
        for (int w = 1; w <= capacity; w++) {

            if (weight[i-1] <= w) {
                dp[i][w] = max(
                    profit[i-1] + dp[i-1][w-weight[i-1]],
                    dp[i-1][w]
                );
            }
            else {
                dp[i][w] = dp[i-1][w];
            }
        }
    }

    cout << "Maximum Profit = " << dp[n][capacity];

    return 0;
}
